# OpenONT common package selection (merged into target seeds)

CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenONT"
CONFIG_VERSION_MANUFACTURER="OpenONT"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/edfwef2w2/openont"
CONFIG_VERSION_PRODUCT="OpenONT"
CONFIG_VERSION_HOME_URL="https://github.com/edfwef2w2/openont"
CONFIG_VERSION_BUG_URL="https://github.com/edfwef2w2/openont/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/edfwef2w2/openont"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/edfwef2w2/openont/releases"
CONFIG_VERSION_REPO="https://github.com/edfwef2w2/openont"
CONFIG_GRUB_TITLE="OpenONT"

# Core OpenONT
CONFIG_PACKAGE_openont-core=y
CONFIG_PACKAGE_openont-base=y
CONFIG_PACKAGE_openont-dpi=y
CONFIG_PACKAGE_openont-stats=y
CONFIG_PACKAGE_luci-theme-openont=y
CONFIG_PACKAGE_luci-mod-openont=y
# Chinese UI catalogue (LuCI i18n package name after feeds/luci.mk)
CONFIG_PACKAGE_luci-i18n-openont-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# LuCI stack (component-level; no luci/luci-light meta collections)
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-light is not set
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-sqm=y
# Only luci-theme-openont; force-disable other theme packages from feeds
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-argon is not set

# Network services
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y

# No wireless NIC / Wi-Fi stack (drivers, firmware, hostapd, scripts)
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-mini is not set
# CONFIG_PACKAGE_wpad-mesh-mbedtls is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpa-supplicant is not set
# CONFIG_PACKAGE_wpa-cli is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwcap is not set
# CONFIG_PACKAGE_wireless-tools is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-mac80211-hwsim is not set
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath9k is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath12k is not set
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mt7601u is not set
# CONFIG_PACKAGE_kmod-iwlwifi is not set
# CONFIG_PACKAGE_kmod-brcmfmac is not set
# CONFIG_PACKAGE_kmod-brcmsmac is not set
# CONFIG_PACKAGE_kmod-rtlwifi is not set
# CONFIG_PACKAGE_kmod-rtw88 is not set
# CONFIG_PACKAGE_kmod-rtw89 is not set
# CONFIG_PACKAGE_kmod-rtl8xxxu is not set
# CONFIG_PACKAGE_kmod-rtl8192cu is not set
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
