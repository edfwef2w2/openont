{#
 # OpenONT login page
-#}
{% include('themes/openont/header') %}
<div class="o-login-wrap">
	<div class="o-login-box">
		<h1>OpenONT</h1>
		<p class="o-login-sub">{{ translate('Administration Login') }}</p>
		<form method="post" action="{{ REQUEST_URI }}">
			{% if error %}<div class="o-alert">{{ error }}</div>{% endif %}
			<label>{{ translate('Username') }}</label>
			<input type="text" name="luci_username" value="{{ duser }}" autocomplete="username" />
			<label>{{ translate('Password') }}</label>
			<input type="password" name="luci_password" autocomplete="current-password" />
			<input type="submit" value="{{ translate('Login') }}" class="o-btn o-btn-primary" />
		</form>
	</div>
</div>
{% include('themes/openont/footer') %}
