{#
 # OpenONT Blue-White Sidebar theme — header
 # LuCI-compatible shell (#topmenu / #maincontent / #indicators)
-#}
{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = boardinfo.hostname ?? 'OpenONT';
	const page_title = dispatched?.title ?? '';
	const doc_title = page_title
		? `OpenONT | ${_(page_title)}`
		: `OpenONT | ${hostname}`;

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="false" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<script>
		/* Apply theme before paint to avoid FOUC.
		   Sidebar enter anim: first visit / new session only.
		   Content enter anim: every page load (including same-menu re-click). */
		(function () {
			try {
				var key = 'openont-theme-dark';
				var dark = localStorage.getItem(key) === '1';
				document.documentElement.setAttribute('data-darkmode', dark ? 'true' : 'false');
				document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
			} catch (e) {
				document.documentElement.setAttribute('data-darkmode', 'false');
				document.documentElement.setAttribute('data-theme', 'light');
			}
			/* Layout mode: same thirds as overview (window / screen)
			   >2/3 wide2x · >1/3 normal · ≤1/3 narrow → sidebar becomes top bar */
			try {
				var screenW = 1920;
				if (window.screen)
					screenW = window.screen.availWidth || window.screen.width || screenW;
				if (!screenW || screenW < 1) screenW = 1920;
				var winW = window.innerWidth || document.documentElement.clientWidth || screenW;
				if (winW < 1) winW = screenW;
				var ratio = winW / screenW;
				var mode = ratio > 2 / 3 ? 'wide2x' : (ratio > 1 / 3 ? 'normal' : 'narrow');
				var html = document.documentElement;
				html.setAttribute('data-layout-mode', mode);
				html.classList.toggle('is-layout-narrow', mode === 'narrow');
				html.classList.toggle('is-layout-wide2x', mode === 'wide2x');
				html.classList.toggle('is-layout-normal', mode === 'normal');
			} catch (e2) {
				document.documentElement.setAttribute('data-layout-mode', 'normal');
				document.documentElement.classList.add('is-layout-normal');
			}
			try {
				if (sessionStorage.getItem('openont-sidebar-ready'))
					document.documentElement.classList.add('bw-sidebar-static');
				sessionStorage.setItem('openont-sidebar-ready', '1');
			} catch (e) { /* ignore */ }
		})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="darkreader-lock" />
		<title>{{ striptags(doc_title) }}</title>
		<link rel="stylesheet" href="{{ media }}/cascade.css" />
		<link rel="stylesheet" media="only screen and (max-device-width: 900px)" href="{{ media }}/mobile.css" />
		<link rel="stylesheet" href="{{ media }}/theme-blue-sidebar.css" />
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}" />
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>
	<body class="lang_{{ dispatcher.lang }} {{ ctx.authsession ? 'logged-in' : 'node-main-login' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<header>
			<a class="brand" href="{{ ctx.authsession ? dispatcher.build_url('admin/status/overview') : '#' }}">OpenONT</a>
			{% if (ctx.authsession): %}
			<ul class="nav" id="topmenu" style="display:none"></ul>
			<script>
			/* Sync-hydrate sidebar from last session paint so hard nav is not empty. */
			(function () {
				try {
					var el = document.getElementById('topmenu');
					var html = sessionStorage.getItem('openont-topmenu-html');
					if (!el || !html)
						return;
					el.innerHTML = html;
					el.style.display = '';
					el.classList.add('bw-menu-ready');
					document.documentElement.classList.add('bw-menu-hydrated');

					/* Re-tag active/open from data-page before async menu replaces tree */
					var dp = (document.body && document.body.getAttribute('data-page')) || '';
					var parts = dp.split('-').filter(Boolean);
					if (!parts.length)
						return;
					var want = parts[0] === 'admin' ? parts : ['admin'].concat(parts);
					var links = el.querySelectorAll('a[href]');
					var best = null;
					function pathOk(href, segs) {
						if (!href || href === '#') return false;
						try {
							var a = document.createElement('a');
							a.href = href;
							var p = (a.pathname || '').split('/').filter(Boolean);
							var idx = p.lastIndexOf('luci');
							var rest = idx >= 0 ? p.slice(idx + 1) : p;
							if (rest.length < segs.length) return false;
							for (var i = 0; i < segs.length; i++)
								if (rest[i] !== segs[i]) return false;
							return true;
						} catch (e) { return false; }
					}
					Array.prototype.forEach.call(el.querySelectorAll('li.active, li.open'), function (li) {
						li.classList.remove('active');
						li.classList.remove('open');
						var ma = li.querySelector(':scope > a.menu');
						if (ma) ma.setAttribute('aria-expanded', 'false');
					});
					Array.prototype.forEach.call(links, function (a) {
						var href = a.getAttribute('href');
						if (pathOk(href, want) || (want.length >= 3 && pathOk(href, want.slice(0, 3)))) {
							if (!best || href.length >= best.getAttribute('href').length)
								best = a;
						}
					});
					if (!best && want.length >= 2) {
						Array.prototype.forEach.call(links, function (a) {
							if (pathOk(a.getAttribute('href'), want.slice(0, 2)))
								best = a;
						});
					}
					if (best && best.parentElement) {
						best.parentElement.classList.add('active');
						var drop = best.closest('li.dropdown');
						if (drop) {
							drop.classList.add('open');
							var menuA = drop.querySelector(':scope > a.menu');
							if (menuA) menuA.setAttribute('aria-expanded', 'true');
						}
					}
				} catch (e) { /* ignore */ }
			})();
			</script>
			<div class="bw-theme-switch" id="bw-theme-switch">
				<button type="button" class="bw-theme-toggle" id="bw-theme-toggle"
					aria-pressed="false" title="{{ _('Toggle light / dark mode') }}">
					<span class="bw-theme-toggle-icon bw-icon-sun" aria-hidden="true"></span>
					<span class="bw-theme-toggle-icon bw-icon-moon" aria-hidden="true"></span>
					<span class="bw-theme-toggle-text">{{ _('Dark mode') }}</span>
				</button>
			</div>
			<div id="indicators" class="pull-right"></div>
			{% endif %}
		</header>

		<div id="maincontent" class="container">
			{% if (ctx.authsession && getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup('admin/system/admin')): %}
					<div class="right">
						<a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a>
					</div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == 'initramfs'): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup('admin/system/flash')): %}
					<div class="right">
						<a class="btn" href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a>
					</div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
