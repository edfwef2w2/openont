#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

START=98
USE_PROCD=1
STOP=10

start_service() {
	mkdir -p /tmp/openont-stats /tmp/dnsmasq.d /etc/openont

	if [ -x /usr/sbin/openont-classify ]; then
		procd_open_instance classify
		procd_set_param command /usr/sbin/openont-classify
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi

	if [ -x /usr/sbin/openont-dpi ]; then
		procd_open_instance dpi
		procd_set_param command /usr/sbin/openont-dpi
		procd_set_param env OPENONT_DPI_MODE=sample OPENONT_DPI_QUEUE=10
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi

	procd_open_instance statsd
	procd_set_param command /usr/sbin/openont-statsd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	[ -x /usr/lib/openont/dpi-nft.sh ] && /usr/lib/openont/dpi-nft.sh stop 2>/dev/null || true
	rm -f /tmp/dnsmasq.d/openont-classify.conf 2>/dev/null || true
}
