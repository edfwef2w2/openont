#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=21
STOP=89
USE_PROCD=1

start_service() {
	local en accel
	. /usr/lib/openont/dns.sh
	openont_dns_drop_legacy_accel
	en=$(uci -q get openont-dns.main.enabled)
	if [ "$en" != "1" ]; then
		openont_dns_desync_down
		return 0
	fi

	mkdir -p /tmp/openont-dns /tmp/openont-stats /var/lib/openont-dns/lists /etc/openont/dns
	openont_dns_claim_dnsmasq
	openont_dns_write_conf
	openont_dns_ensure_sets
	accel=$(uci -q get openont-dns.main.accel_enabled)
	if [ "$accel" = "1" ]; then
		openont_dns_desync_up
	else
		openont_dns_desync_down
	fi

	procd_open_instance dnsd
	procd_set_param command /usr/sbin/openont-dnsd /tmp/openont-dns/dnsd.conf
	procd_set_param respawn 3600 5 5
	procd_set_param file /tmp/openont-dns/dnsd.conf
	procd_close_instance

	if [ "$accel" = "1" ]; then
		procd_open_instance desync
		procd_set_param command /usr/sbin/openont-desync /tmp/openont-dns/desync.conf
		procd_set_param respawn 3600 5 5
		procd_set_param file /tmp/openont-dns/desync.conf
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance refresh
	procd_set_param command /usr/lib/openont/dns-refresh.sh
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	. /usr/lib/openont/dns.sh
	openont_dns_desync_down
	openont_dns_release_dnsmasq
}
