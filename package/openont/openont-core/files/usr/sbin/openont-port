#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
. /usr/lib/openont/port.sh

usage() {
	cat <<USAGE
Usage: openont-port <command> [args]

Roles are lanN (bridge of one or more ports) and wanN (exactly one port).
Changing ports keeps the role's address/protocol and DHCP pool.

Commands:
  list|show
  create <lan|wan> <eth...> [dhcp|pppoe|static]   next free lanN / wanN
  set <lanN|wanN> <eth...> [dhcp|pppoe|static]    create or rebind
      openont-port set lan1 eth0 eth1
      openont-port set wan1 eth2 pppoe
  add <lanN> <eth>
  del-port <lanN> <eth>
  del <lanN|wanN>
  status-json

Address/protocol: openont-address.  DHCP pools: openont-dhcp.
USAGE
}

cmd="${1:-}"
[ -n "$cmd" ] && shift

case "$cmd" in
	list|show) openont_port_list ;;
	create) openont_port_create "$@" ;;
	set) openont_port_set "$@" ;;
	add) openont_port_add "$@" ;;
	del-port) openont_port_del_port "$@" ;;
	del|delete) openont_port_del "$@" ;;
	status-json) openont_port_status_json ;;
	-h|--help|help|"") usage; [ -n "$cmd" ] || exit 1 ;;
	*) echo "unknown: $cmd" >&2; usage; exit 1 ;;
esac
