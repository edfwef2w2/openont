# Unified OpenONT RPC — same backend as CLI tools.

. /usr/share/libubox/jshn.sh 2>/dev/null || true
. /usr/lib/openont/common.sh 2>/dev/null || true
. /usr/lib/openont/role.sh 2>/dev/null || true
. /usr/lib/openont/address.sh 2>/dev/null || true
. /usr/lib/openont/dhcp.sh 2>/dev/null || true
. /usr/lib/openont/port.sh 2>/dev/null || true
. /usr/lib/openont/nat.sh 2>/dev/null || true
. /usr/lib/openont/ipgroup.sh 2>/dev/null || true
. /usr/lib/openont/offload.sh 2>/dev/null || true
. /usr/lib/openont/pppoe.sh 2>/dev/null || true

. /usr/lib/openont/stats-paths.sh 2>/dev/null || true
. /usr/lib/openont/stats_rpc.sh 2>/dev/null || true
. /usr/lib/openont/dns.sh 2>/dev/null || true

# --- stats paths (rates for overview/status) ---
STATS_DIR="${OPENONT_STATS_DIR:-/tmp/openont-stats}"
HIST_FILE="${OPENONT_HIST_FILE:-$STATS_DIR/history.jsonl}"

read_cpu_pair() {
	local a b c d e f g h i j
	read _ a b c d e f g h i j < /proc/stat
	echo "$d $((a+b+c+d+e+f+g+h+i+j))"
}

cpu_percent() {
	local i1 t1 i2 t2
	set -- $(read_cpu_pair); i1=$1; t1=$2
	sleep 0.15
	set -- $(read_cpu_pair); i2=$1; t2=$2
	local dt=$((t2-t1)) di=$((i2-i1))
	[ "$dt" -gt 0 ] || { echo 0; return; }
	echo $((100*(dt-di)/dt))
}

mem_percent() {
	local total avail
	total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
	avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
	[ "${total:-0}" -gt 0 ] || { echo 0; return; }
	echo $((100 - 100 * ${avail:-0} / total))
}

read_rates() {
	[ -f "$STATS_DIR/rates.json" ] && cat "$STATS_DIR/rates.json" || echo '{"rx_bps":0,"tx_bps":0}'
}

list_role() {
	openont_role_list "$1"
}

rpc_status() {
	local rates rx tx
	rates=$(read_rates)
	rx=$(echo "$rates" | jsonfilter -e '@.rx_bps' 2>/dev/null || echo 0)
	tx=$(echo "$rates" | jsonfilter -e '@.tx_bps' 2>/dev/null || echo 0)
	json_init
	json_add_int cpu "$(cpu_percent)"
	json_add_int mem "$(mem_percent)"
	json_add_int rx_bps "$rx"
	json_add_int tx_bps "$tx"
	json_dump
}

rpc_overview() {
	# reuse port status for interfaces detail
	local rates rx tx wan_ok=0 wan_n=0 lan_n=0
	rates=$(read_rates)
	rx=$(echo "$rates" | jsonfilter -e '@.rx_bps' 2>/dev/null || echo 0)
	tx=$(echo "$rates" | jsonfilter -e '@.tx_bps' 2>/dev/null || echo 0)
	for _ in $(list_role wan); do wan_n=$((wan_n+1)); done
	for _ in $(list_role lan); do lan_n=$((lan_n+1)); done
	for r in $(list_role wan); do
		ubus call network.interface."$r" status 2>/dev/null | grep -q '"up": true' && wan_ok=1
	done
	[ "$wan_ok" -eq 0 ] && ip route 2>/dev/null | grep -q '^default ' && wan_ok=1

	local hosts conns rem=0 n
	# grep -c prints 0 but exits 1 on no match; never use "|| echo 0" (doubles the value).
	hosts=$(grep -c . /tmp/dhcp.leases 2>/dev/null || true)
	hosts=${hosts:-0}
	if [ "$hosts" -eq 0 ]; then
		hosts=$(ip -4 neigh show 2>/dev/null | grep -c lladdr || true)
		hosts=${hosts:-0}
	fi
	conns=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
	conns=${conns:-0}
	# Free addresses summed over all LAN pools (disabled pools report 0).
	for n in $(openont_dhcp_status_json 2>/dev/null | jsonfilter -e '@.pools[*].remaining' 2>/dev/null); do
		rem=$((rem + n))
	done

	json_init
	json_add_string hostname "$(uci -q get system.@system[0].hostname 2>/dev/null || echo OpenONT)"
	json_add_boolean wan_connected "$wan_ok"
	json_add_int uptime_sec "$(cut -d. -f1 /proc/uptime)"
	json_add_int rx_bps "$rx"
	json_add_int tx_bps "$tx"
	json_add_int hosts "$hosts"
	json_add_int connections "$conns"
	json_add_int wired "$hosts"
	json_add_int wan_enabled "$wan_n"
	json_add_int lan_enabled "$lan_n"
	json_add_int dhcp_remaining "$rem"
	json_add_int cpu "$(cpu_percent)"
	json_add_int mem "$(mem_percent)"
	# also structured interfaces from roles
	json_add_array interfaces
	for role in $(list_role wan) $(list_role lan); do
		dev=$(uci -q get "network.$role.device")
		proto=$(uci -q get "network.$role.proto")
		ports=$(openont_role_ports "$role" 2>/dev/null)
		up=0
		ubus call network.interface."$role" status 2>/dev/null | grep -q '"up": true' && up=1
		ip=$(ubus call network.interface."$role" status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
		json_add_object
		json_add_string name "$role"
		json_add_string device "$dev"
		json_add_string proto "$proto"
		json_add_boolean up "$up"
		json_add_string ip "$ip"
		json_add_string ports "$ports"
		json_close_object
	done
	json_close_array
	json_dump
}

# Everything the Interfaces page shows: ports, roles with their protocol
# settings, DHCP summary and runtime state. Passwords are never returned.
rpc_iface_status() {
	local role first=1
	printf '{"physical":'
	openont_port_physical_json
	printf ',"next":{"lan":"%s","wan":"%s"},' "$(openont_role_next lan)" "$(openont_role_next wan)"
	printf '"roles":['
	for role in $(openont_role_list); do
		[ "$first" -eq 1 ] || printf ','
		first=0
		printf '{"name":"%s","type":"%s","proto":"%s",' \
			"$role" "$(openont_role_type "$role")" \
			"$(openont_json_escape "$(uci -q get "network.$role.proto")")"
		printf '"ipaddr":"%s","gateway":"%s","dns":"%s",' \
			"$(openont_json_escape "$(openont_role_cidr "$role")")" \
			"$(openont_json_escape "$(uci -q get "network.$role.gateway")")" \
			"$(openont_json_escape "$(uci -q get "network.$role.dns" | xargs)")"
		printf '"username":"%s","has_password":%s,' \
			"$(openont_json_escape "$(uci -q get "network.$role.username")")" \
			"$([ -n "$(uci -q get "network.$role.password")" ] && echo true || echo false)"
		printf '"ports":'
		openont_port_role_ports_json "$role"
		printf ','
		if [ "$(openont_role_type "$role")" = "lan" ]; then
			printf '"dhcp":'
			openont_dhcp_pool_json "$role"
			printf ','
		fi
		printf '"state":'
		openont_pppoe_iface_json "$role"
		printf '}'
	done
	printf '],"stats":'
	openont_port_stats_json
	printf '}\n'
}

# iface_proto: role, proto, ipaddr, gateway, dns[], username, password
rpc_iface_proto() {
	local role="$1" proto="$2"
	case "$proto" in
		static) openont_address_set "$role" "$3" "$4" $5 ;;
		dhcp) openont_address_dhcp "$role" ;;
		pppoe) openont_address_pppoe "$role" "$6" "$7" ;;
		*) echo "invalid proto: $proto" >&2; return 1 ;;
	esac
}

# Generic exec helpers returning CLI text as JSON
rpc_call_wrap() {
	local out
	out=$("$@" 2>&1)
	rc=$?
	if [ $rc -eq 0 ]; then
		# if already json
		case "$out" in
			\{*) printf '%s\n' "$out" ;;
			*) openont_ok "$out" ;;
		esac
	else
		openont_err "$out"
	fi
}

case "$1" in
	list)
		json_init
		for m in status overview history dpi_status \
			iface_status iface_create iface_ports iface_delete iface_proto \
			dhcp_status dhcp_leases dhcp_pool_set dhcp_static_set dhcp_static_del \
			ipgroup_list ipgroup_set ipgroup_del \
			portmap_list portmap_add portmap_del portmap_enable portmap_disable \
			dmz_list dmz_add dmz_del dmz_enable dmz_disable \
			offload_detect offload_status offload_set \
			pppoe_dial pppoe_hangup pppoe_redial \
			dns_status dns_set \
			dns_upstream_list dns_upstream_set dns_upstream_del \
			dns_domain_list dns_domain_set dns_domain_del \
			dns_filter_list dns_filter_set dns_filter_del \
			dns_blocklist_set dns_blocklist_del \
			dns_rewrite_set dns_rewrite_del \
			dns_client_set dns_client_del \
			dns_accel_list dns_accel_set dns_accel_del dns_accel_cfg \
			dns_log
		do
			json_add_object "$m"
			json_close_object
		done
		json_dump
		;;
	call)
		input=$(cat)
		get() { echo "$input" | jsonfilter -e "@.$1" 2>/dev/null; }
		# Array argument (or a space-separated string) as words.
		getlist() {
			local v
			v=$(echo "$input" | jsonfilter -e "@.$1[*]" 2>/dev/null)
			[ -n "$v" ] || v=$(get "$1")
			echo $v
		}
		case "$2" in
			status) rpc_status ;;
			overview) rpc_overview ;;
			history)
				rpc_history "$(get window)"
				;;
			dpi_status)
				rpc_dpi_status
				;;
			iface_status)
				rpc_iface_status
				;;
			iface_create)
				rpc_call_wrap openont_port_create "$(get type)" $(getlist ports) $(get proto)
				;;
			iface_ports)
				rpc_call_wrap openont_port_set "$(get role)" $(getlist ports)
				;;
			iface_delete)
				rpc_call_wrap openont_port_del "$(get role)"
				;;
			iface_proto)
				rpc_call_wrap rpc_iface_proto "$(get role)" "$(get proto)" \
					"$(get ipaddr)" "$(get gateway)" "$(getlist dns)" \
					"$(get username)" "$(get password)"
				;;
			dhcp_status)
				openont_dhcp_status_json
				;;
			dhcp_leases)
				openont_dhcp_leases_json
				;;
			dhcp_pool_set)
				rpc_call_wrap openont_dhcp_pool "$(get role)" "$(get enabled)" \
					"$(get start)" "$(get limit)" "$(get leasetime)"
				;;
			dhcp_static_set)
				rpc_call_wrap openont_dhcp_static_set "$(get id)" "$(get mac)" \
					"$(get ip)" "$(get name)"
				;;
			dhcp_static_del)
				rpc_call_wrap openont_dhcp_static_del "$(get id)"
				;;
			ipgroup_list)
				openont_ipgroup_status_json
				;;
			ipgroup_set)
				id=$(get id); name=$(get name); comment=$(get comment)
				entries=$(get entries)
				# entries as space-separated from json array join on client
				rpc_call_wrap openont_ipgroup_set "$id" "$name" "$comment" $entries
				;;
			ipgroup_del)
				rpc_call_wrap openont_ipgroup_del "$(get id)"
				;;
			portmap_list)
				openont_nat_list_json portmap
				;;
			portmap_add)
				rpc_call_wrap openont_nat_portmap_add \
					"$(get name)" "$(get dest_ip)" "$(get dest_port)" \
					"$(get proto)" "$(get src_dport)" "$(get src_group)" "$(get enabled)"
				;;
			portmap_del)
				rpc_call_wrap openont_nat_del "$(get name)"
				;;
			portmap_enable)
				rpc_call_wrap openont_nat_set_enabled "$(get name)" 1
				;;
			portmap_disable)
				rpc_call_wrap openont_nat_set_enabled "$(get name)" 0
				;;
			dmz_list)
				openont_nat_list_json dmz
				;;
			dmz_add)
				rpc_call_wrap openont_nat_dmz_add \
					"$(get name)" "$(get dest_ip)" "$(get enabled)" \
					"$(get excl_proto)" "$(get excl_port)"
				;;
			dmz_del)
				rpc_call_wrap openont_nat_del "$(get name)"
				;;
			dmz_enable)
				rpc_call_wrap openont_nat_set_enabled "$(get name)" 1
				;;
			dmz_disable)
				rpc_call_wrap openont_nat_set_enabled "$(get name)" 0
				;;
			offload_detect|offload_status)
				openont_offload_detect_json
				;;
			offload_set)
				rpc_call_wrap openont_offload_set "$(get mode)"
				;;
			pppoe_dial)
				rpc_call_wrap openont_pppoe_dial "$(get iface)"
				;;
			pppoe_hangup)
				rpc_call_wrap openont_pppoe_hangup "$(get iface)"
				;;
			pppoe_redial)
				rpc_call_wrap openont_pppoe_redial "$(get iface)"
				;;
			dns_status)
				openont_dns_status_json
				;;
			dns_set)
				openont_dns_set "$(get enabled)" "$(get port)" "$(get cache_size)" \
					"$(get min_ttl)" "$(get max_ttl)" "$(get serve_expired)" "$(get prefetch)" \
					"$(get response_mode)" "$(get speed_check)" "$(get ip_pref)" \
					"$(get block_mode)" "$(get log_size)" "$(get bogus)"
				;;
			dns_upstream_list)
				openont_dns_upstream_list_json
				;;
			dns_upstream_set)
				openont_dns_upstream_set "$(get id)" "$(get name)" "$(get group)" "$(get proto)" \
					"$(get address)" "$(get port)" "$(get tls_host)" "$(get doh_path)" "$(get enabled)"
				;;
			dns_upstream_del|dns_domain_del|dns_filter_del|dns_blocklist_del|dns_rewrite_del|dns_client_del|dns_accel_del)
				openont_dns_section_del "$(get id)"
				;;
			dns_domain_list)
				openont_dns_domain_list_json
				;;
			dns_domain_set)
				openont_dns_domain_set "$(get id)" "$(get pattern)" "$(get match)" "$(get group)" "$(get nftset)"
				;;
			dns_filter_list)
				openont_dns_filter_list_json
				;;
			dns_filter_set)
				openont_dns_filter_set "$(get id)" "$(get text)" "$(get client)"
				;;
			dns_blocklist_set)
				openont_dns_blocklist_set "$(get id)" "$(get name)" "$(get url)" "$(get enabled)" "$(get refresh)"
				;;
			dns_rewrite_set)
				openont_dns_rewrite_set "$(get id)" "$(get pattern)" "$(get match)" "$(get type)" "$(get value)"
				;;
			dns_client_set)
				openont_dns_client_set "$(get id)" "$(get address)"
				;;
			dns_accel_list)
				openont_dns_accel_list_json
				;;
			dns_accel_set)
				openont_dns_accel_set "$(get id)" "$(get domain)" "$(get enabled)"
				;;
			dns_accel_cfg)
				openont_dns_accel_cfg "$(get enabled)" "$(get fooling)" "$(get ttl_mode)" \
					"$(get ttl)" "$(get ttl_delta)" "$(get repeat)" "$(get fake_sni)"
				;;
			dns_log)
				openont_dns_log_json "$(get limit)" "$(get kind)"
				;;
			*)
				echo '{"ok":false,"error":"unknown method"}'
				;;
		esac
		;;
esac
