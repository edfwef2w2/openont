#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Lightweight app classifier: dnsmasq DNS replies → IP category map.
# game_udp ports are applied in openont-statsd (G3).

STATS_DIR="/tmp/openont-stats"
MAP_FILE="$STATS_DIR/ip_class.map"
DNS_LOG="$STATS_DIR/dns.log"
DNS_POS="$STATS_DIR/dns.log.pos"
CONF_SYS="/usr/share/openont/app-class.conf"
CONF_USR="/etc/openont/app-class.conf"
DNSMASQ_DROPIN="/tmp/dnsmasq.d/openont-appclass.conf"
# keyword|category lines, longest keyword first
KW_FILE="$STATS_DIR/class_keywords.txt"
MAP_TTL=3600

mkdir -p "$STATS_DIR" /tmp/dnsmasq.d /etc/openont 2>/dev/null

build_keywords() {
	local conf line cat key
	: > "$KW_FILE.raw"
	for conf in "$CONF_SYS" "$CONF_USR"; do
		[ -f "$conf" ] || continue
		while IFS= read -r line || [ -n "$line" ]; do
			line=${line%%#*}
			line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
			[ -z "$line" ] && continue
			case "$line" in
				game_udp\|*) continue ;;
			esac
			cat=$(echo "$line" | cut -d'|' -f1)
			key=$(echo "$line" | cut -d'|' -f2 | tr 'A-Z' 'a-z')
			[ -n "$cat" ] && [ -n "$key" ] || continue
			echo "$key|$cat"
		done < "$conf" >> "$KW_FILE.raw"
	done
	# longest keyword first for specificity
	awk -F'|' '{ print length($1), $0 }' "$KW_FILE.raw" 2>/dev/null | \
		sort -rn | cut -d' ' -f2- > "$KW_FILE"
	rm -f "$KW_FILE.raw"
}

class_of_host() {
	local host="$1" key cat
	host=$(echo "$host" | tr 'A-Z' 'a-z' | sed 's/\.$//')
	[ -z "$host" ] && { echo "unknown"; return; }
	[ -f "$KW_FILE" ] || { echo "other_app"; return; }
	while IFS='|' read -r key cat; do
		[ -n "$key" ] || continue
		case "$host" in
			*"$key"*) echo "$cat"; return ;;
		esac
	done < "$KW_FILE"
	echo "other_app"
}

map_put() {
	local ip="$1" cat="$2" now
	case "$ip" in
		""|127.*|0.*|255.*|::1) return ;;
		*[!0-9a-fA-F:.]*) return ;;
	esac
	now=$(date +%s)
	echo "$ip $cat $now" >> "$MAP_FILE.add"
}

merge_map() {
	local now cutoff
	now=$(date +%s)
	cutoff=$((now - MAP_TTL))
	{
		[ -f "$MAP_FILE" ] && cat "$MAP_FILE"
		[ -f "$MAP_FILE.add" ] && cat "$MAP_FILE.add"
	} 2>/dev/null | awk -v cut="$cutoff" '
		NF >= 2 {
			ip = $1; cat = $2; t = ($3 + 0)
			if (t == 0 || t >= cut) { c[ip] = cat; if (t > 0) ts[ip] = t }
		}
		END { for (ip in c) printf "%s %s %s\n", ip, c[ip], (ts[ip] ? ts[ip] : 0) }
	' > "$MAP_FILE.new"
	mv -f "$MAP_FILE.new" "$MAP_FILE"
	rm -f "$MAP_FILE.add"
}

process_dns_lines() {
	local line rest host ip cat
	local any=0
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			*reply\ *\ is\ *|*config\ *\ is\ *)
				case "$line" in
					*reply\ *\ is\ *) rest=${line#*reply } ;;
					*) rest=${line#*config } ;;
				esac
				host=${rest%% is *}
				ip=${rest#* is }
				ip=${ip%% *}
				case "$ip" in
					[0-9]*.*.*.*) ;;
					*:*:*) ;;
					*) continue ;;
				esac
				host=$(echo "$host" | tr 'A-Z' 'a-z' | sed 's/\.$//')
				[ -z "$host" ] && continue
				cat=$(class_of_host "$host")
				map_put "$ip" "$cat"
				any=1
				;;
		esac
	done
	[ "$any" = 1 ] && merge_map
}

drain_dns_log() {
	local pos size
	[ -f "$DNS_LOG" ] || return
	pos=0
	[ -f "$DNS_POS" ] && pos=$(cat "$DNS_POS" 2>/dev/null)
	pos=${pos:-0}
	# numeric only
	pos=$(echo "$pos" | tr -cd '0-9'); pos=${pos:-0}
	size=$(wc -c < "$DNS_LOG" 2>/dev/null | tr -cd '0-9')
	size=${size:-0}
	if [ "$size" -lt "$pos" ] 2>/dev/null; then
		pos=0
	fi
	if [ "$size" -gt "$pos" ] 2>/dev/null; then
		dd if="$DNS_LOG" bs=1 skip="$pos" 2>/dev/null | process_dns_lines
		echo "$size" > "$DNS_POS"
	fi
}

setup_dnsmasq_log() {
	cat > "$DNSMASQ_DROPIN" <<EOF
# Generated by openont-appclass
log-queries
log-facility=$DNS_LOG
EOF
	touch "$DNS_LOG"
	if [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq reload 2>/dev/null || \
			/etc/init.d/dnsmasq restart 2>/dev/null || true
	fi
}

build_keywords
setup_dnsmasq_log
touch "$MAP_FILE"

REBUILD=0
while true; do
	drain_dns_log
	REBUILD=$((REBUILD + 1))
	# refresh keyword table every ~5 min
	if [ "$REBUILD" -ge 150 ]; then
		build_keywords
		REBUILD=0
	fi
	sleep 2
done
